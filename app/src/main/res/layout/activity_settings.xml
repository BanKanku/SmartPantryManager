
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F5"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#216B45" />

    <TextView
        android:id="@+id/tvPantryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Pantry ingredients: 0"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnClearPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Clear Pantry" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="About Smart Pantry Manager"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#216B45" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Smart Pantry Manager helps you manage pantry ingredients and discover recipes you can prepare with available ingredients."
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSettingsBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Back to Pantry" />

</LinearLayout>
